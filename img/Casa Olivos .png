-b3fd-15545fecbaca/je/1040x620xc.jpg","category":"RealEstate","offers":{"@type":"Offer","availability":"https://schema.org/InStock","priceCurrency":"MXN","price":21350000.0,"seller":{"@type":"Organization","name":"Querétaro Sotheby's International Realty"}}}</script>

          

